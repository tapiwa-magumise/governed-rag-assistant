1" parent="1" ><mxGeometry x="50" y="345" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-0" value="What the Procurement Act 2023 guidance says, with the paragraph cited" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="395" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-1" value="Which thresholds apply, from the current policy notes" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="437" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-2" value="What a live tender notice asks for, and by when" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="479" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-3" value="When a contract award can go ahead after standstill" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="521" width="800" height="34" as="geometry"/></mxCell><mxCell id="s0-4" value="And when the documents don&#x27;t cover a question, it says so" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="563" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-h" value="How each answer is kept honest" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=24;fontStyle=1;" vertex="1" parent="1" ><mxGeometry x="50" y="650" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-0" value="Every answer comes from 260 published documents, and cites them" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="700" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-1" value="Every model call runs in London" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="742" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-2" value="Personal data masked twice: none found in 2,276 passages" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="784" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-3" value="No close passage, no model call, no guess" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="826" width="800" height="34" as="geometry"/></mxCell><mxCell id="s1-4" value="Answers below the grounding bars are withheld, and all are logged" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="868" width="800" height="34" as="geometry"/></mxCell><mxCell id="note" value="Being evaluated on 32 questions with known answers, 20 outside its documents and 10 prompt injection attempts. Results to follow." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontColor=light-dark(#232F3E,#D4D4D4);fontSize=20;" vertex="1" parent="1" ><mxGeometry x="50" y="955" width="800" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>